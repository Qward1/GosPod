{
  "$id": "https://kontakt-centr.mosreg.ru/identity.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Сотрудник контакт-центра",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Электронная почта / логин",
          "ory.sh/kratos": {
            "credentials": { "password": { "identifier": true } },
            "verification": { "via": "email" }
          }
        },
        "name": {
          "type": "string",
          "title": "ФИО сотрудника"
        },
        "role": {
          "type": "string",
          "title": "Роль",
          "enum": ["Оператор", "Администратор"],
          "default": "Оператор"
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
